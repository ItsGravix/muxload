{
  "name": "@itsgravix/muxload",
  "version": "0.6.0",
  "description": "Resumable JavaScript uploads for files larger than CDN, reverse-proxy, or server request-body limits, with concurrent scheduling and real progress.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": "./src/client.js",
    "./client": "./src/client.js",
    "./server": "./src/server.js",
    "./protocol": "./src/protocol.js",
    "./storage": "./src/storage.js"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/client.js && node --check src/server.js && node --check src/protocol.js"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "express": ">=4.18"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "express": "^5.1.0"
  },
  "keywords": [
    "large-file-upload",
    "browser-upload",
    "chunked-upload",
    "concurrent-upload",
    "upload",
    "resumable",
    "resumable-upload",
    "multipart",
    "multiplexing",
    "file-transfer",
    "upload-progress",
    "retry",
    "resume",
    "javascript",
    "nodejs",
    "express",
    "serverless",
    "fetch-api",
    "cloudflare",
    "reverse-proxy",
    "request-body-limit",
    "cdn-upload",
    "xhr"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsGravix/muxload.git"
  },
  "bugs": {
    "url": "https://github.com/ItsGravix/muxload/issues"
  },
  "homepage": "https://github.com/ItsGravix/muxload#readme"
}
